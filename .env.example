# Copy to `.env.local` (gitignored) and fill in locally. Never commit real values.
# See SECURITY-ROTATION.md for where each value comes from.

# Next.js route handlers (server-side only, no NEXT_PUBLIC_ prefix)
STRIPE_SECRET_KEY=

# Cloud Functions secrets. These are NOT read from this file in production;
# they are set with `firebase functions:secrets:set <NAME>`.
# Listed here so the names are documented and greppable.
STRIPE_WEBHOOK_SECRET=

# Public client configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx   # publishable key (safe to expose)
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_BASE_URL=
NEXT_PUBLIC_BASE_URL=
