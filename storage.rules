rules_version = '2';

// Storage rules for raffleapp-dbc1b (repo: ~/Projects/new-raffles-app)
//
// STATUS: WRITTEN FROM THE DATA MODEL, NOT DEPLOYED, NOT EMULATOR-TESTED.
// No storage.rules existed in the repo; no upload path was found in app/.
// These rules are therefore mainly a lock, not a feature: they close the
// bucket to anonymous writes and keep image reads public for the storefront.
//
// If raffle/bet images are uploaded from the admin UI, the upload writes to
// raffles/{id}/* or bets/{id}/* and is admin-only below. If your uploads use
// a different path, this will block them -- check before deploy.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Public images for the storefront (raffle art, bet art).
    // 5 MB ceiling keeps a single upload from bloating the bucket.
    match /raffles/{raffleId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage()
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /bets/{betId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage()
        && request.resource.size < 5 * 1024 * 1024;
    }

    // Transfer-checkout receipt uploads (app/checkout/transfer/page.tsx:236).
    // Written by the customer from the public cart, so write cannot require
    // auth. Constrained instead: image only, 5 MB ceiling, and the object name
    // must be the 16-digit pago-concept key the server validates
    // (functions/src/index.ts:1230-1234). Read stays open because the same
    // client immediately calls getDownloadURL() on the reference it just
    // wrote; token-bearing download URLs are not gated by rules anyway.
    match /salesImages/{conceptKey} {
      allow read: if true;
      allow write: if isImage()
        && request.resource.size < 5 * 1024 * 1024
        && conceptKey.matches('^\\d{16}$');
    }

    // Everything else: deny.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
